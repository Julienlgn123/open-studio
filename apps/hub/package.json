{
  "name": "open-studio",
  "version": "2.1.0",
  "description": "Open Studio : une seule app, des modules à ajouter (Cours Studio, Drive Studio, Local IA Studio…).",
  "author": {
    "name": "Julienlgn123",
    "email": "129546749+Julienlgn123@users.noreply.github.com"
  },
  "homepage": "https://github.com/Julienlgn123/open-studio",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:test": "electron-vite build --mode test && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.open-studio.app",
    "productName": "Open Studio",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/**/*.map"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Open Studio",
      "artifactName": "Open-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Open-Studio-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Open-Studio-${version}-${arch}.${ext}",
      "icon": "resources/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Open Studio ${version}",
      "artifactName": "Open-Studio-${version}-${arch}.dmg",
      "window": {
        "width": 540,
        "height": 400
      },
      "contents": [
        {
          "x": 130,
          "y": 150,
          "type": "file"
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 300,
          "type": "file",
          "path": "resources/Fix-macOS-Signature.command"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Utility"
    },
    "appImage": {
      "artifactName": "Open-Studio-${version}.AppImage"
    },
    "deb": {
      "artifactName": "Open-Studio-${version}.deb"
    },
    "publish": {
      "provider": "github",
      "owner": "Julienlgn123",
      "repo": "open-studio"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-llama-cpp/**/*",
      "node_modules/@node-llama-cpp/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/fluent-ffmpeg/**/*"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "follow-redirects": "^1.15.9",
    "framer-motion": "^12.23.6",
    "googleapis": "^144.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.18.5",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.2",
    "node-llama-cpp": "^3.6.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.27.7",
    "uuid": "^9.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/follow-redirects": "^1.14.4",
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "35.7.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
