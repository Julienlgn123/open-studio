{
  "name": "cours-studio",
  "version": "1.9.0",
  "description": "Application locale de prise et gestion de cours",
  "author": {
    "name": "Julienlgn123",
    "email": "129546749+Julienlgn123@users.noreply.github.com"
  },
  "homepage": "https://github.com/Julienlgn123/open-studio/tree/main/apps/cours-studio",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild --only better-sqlite3",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "dist": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.cours-studio.app",
    "productName": "Cours Studio",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/**/*.map"
    ],
    "afterPack": "scripts/afterPack.js",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/fluent-ffmpeg/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "extraResources": [
        {
          "from": "../../node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "ffmpeg/ffmpeg.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Cours Studio",
      "license": null,
      "artifactName": "Cours-Studio-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Cours-Studio-${version}-${arch}.${ext}",
      "icon": "resources/icon.png",
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "../../node_modules/ffmpeg-static/ffmpeg",
          "to": "ffmpeg/ffmpeg"
        }
      ]
    },
    "dmg": {
      "title": "Cours Studio ${version}",
      "artifactName": "Cours-Studio-${version}-${arch}.dmg",
      "window": {
        "width": 540,
        "height": 400
      },
      "contents": [
        {
          "x": 130,
          "y": 150,
          "type": "file"
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 300,
          "type": "file",
          "path": "resources/Fix-macOS-Signature.command"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Education",
      "extraResources": [
        {
          "from": "../../node_modules/ffmpeg-static/ffmpeg",
          "to": "ffmpeg/ffmpeg"
        }
      ]
    },
    "deb": {
      "artifactName": "Cours-Studio-${version}.deb"
    },
    "publish": null
  },
  "dependencies": {
    "@tiptap/extension-character-count": "^2.10.4",
    "@tiptap/extension-code-block": "^2.10.4",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.10.4",
    "@tiptap/extension-image": "^2.10.4",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.10.4",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.10.4",
    "@tiptap/extension-task-list": "^2.10.4",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-typography": "^2.10.4",
    "@tiptap/extension-underline": "^2.10.4",
    "@tiptap/pm": "^2.10.4",
    "@tiptap/react": "^2.10.4",
    "@tiptap/starter-kit": "^2.10.4",
    "@tiptap/suggestion": "^2.27.2",
    "@types/katex": "^0.16.8",
    "better-sqlite3": "^11.10.0",
    "date-fns": "^4.1.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.23.6",
    "jszip": "^3.10.1",
    "katex": "^0.18.5",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "35.7.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
