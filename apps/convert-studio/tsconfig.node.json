{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "paths": {
      "@open-studio/module": [
        "../../packages/module-api/src/host.ts"
      ],
      "@open-studio/kit": [
        "../../packages/module-api/src/kit-main.ts"
      ]
    }
  },
  "include": [
    "src/main/**/*",
    "../../packages/module-api/src/host.ts",
    "../../packages/module-api/src/types.ts",
    "../../packages/module-api/src/kit-main.ts",
    "src/shared/**/*"
  ]
}
