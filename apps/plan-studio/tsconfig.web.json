{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@ui": [
        "../../packages/module-ui/index.tsx"
      ],
      "@open-studio/kit": [
        "../../packages/module-api/src/kit-preload.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/**/*",
    "../../packages/module-ui/*.tsx",
    "src/shared/**/*"
  ]
}
