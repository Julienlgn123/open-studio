{
  "name": "open-studio-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo de la suite Julien Studio : Open Studio (hub) et les apps qu'il installe/lance.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:hub": "npm run dev -w apps/hub",
    "dev:local-ia-studio": "npm run dev -w apps/local-ia-studio",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@35.7.5": true,
    "esbuild@0.25.12": true,
    "node-llama-cpp": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
